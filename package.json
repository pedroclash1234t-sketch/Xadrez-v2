{
  "name": "midnight-chess",
  "private": true,
  "version": "1.0.0",
  "description": "Midnight Chess — xadrez local para dois jogadores, no navegador.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "verify": "npm run verify:vendor && npm run typecheck && npm run test && npm run test:audit && npm run test:e2e",
    "verify:vendor": "cd vendor && sha256sum -c UPSTREAM.sha256",
    "apk": "node scripts/build.mjs && npx cap add android && npx cap sync android && cd android && ./gradlew assembleDebug",
    "apk:update": "node scripts/build.mjs && npx cap sync android && cd android && ./gradlew assembleDebug",
    "test:audit": "tsx --test \"tests/audit/**/*.test.ts\"",
    "test:chessjs": "node tests/upstream-chessjs/run.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.0",
    "playwright": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
